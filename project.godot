; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HaraTomo"
run/main_scene="uid://ddvdpi5i0hjuf"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://textures/boot/splash.png"

[autoload]

FoodLibrary="*res://scripts/FoodLibrary.gd"
DrinkLibrary="*res://scripts/DrinkLibrary.gd"
GameData="*res://scripts/game_data.gd"
PetState="*res://scripts/pet_state.gd"
Collection="*res://scripts/collection.gd"
LuckyPinch="*res://scripts/lucky_pinch_state.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/resizable=false
window/stretch/mode="viewport"
window/handheld/orientation=1

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/vram_compression/import_etc2_astc=true
